    parser.add_argument('-f', '--force-refresh', action='store_true', help='Force a refresh of GPS/VPN data.')
    parser.add_argument('--clear-cache', action='store_true', help='Clear all cached data.')
    parser.add_argument('-s', '--speedtest', action='store_true', help='Perform a speed test.')
    parser.add_argument('-l', '--list', action='store_true', help='List IP history.')
    parser.add_argument('--quickest_dev', action='store_true', help='Show active WiFi devices.')
    args = parser.parse_args()

    if args.clear_cache:
        if os.path.exists(CONFIG_FILE): os.remove(CONFIG_FILE)
        print("Cache cleared.")
        exit()

    data = load_data(args.verbose)
    if args.quickest_dev: display_quickest_devices(args.verbose); exit()
    if args.list: list_known_ips(data); exit()

    data, public_ip, vpn_status = get_ip_details(data, verbose=args.verbose, force_refresh=args.force_refresh)
    if args.speedtest and public_ip: data = run_speed_test(data, public_ip, vpn_status, verbose=args.verbose)
    save_data(data, args.verbose)