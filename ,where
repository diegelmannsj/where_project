    parser.add_argument('--update-vpn-list', action='store_true', help='Force a refresh of the known VPN IP list.')
    parser.add_argument('--clear-cache', action='store_true', help='Clear all cached data (VPN IPs, GPS, and results).')
    parser.add_argument('-G', '--no-gps', action='store_true', help='Skip all GPS-related functions.')
    parser.add_argument('-s', '--speedtest', action='store_true', help='Perform a network speed test.')
    
    if ARGCOMPLETE_ENABLED: argcomplete.autocomplete(parser)
    args = parser.parse_args()

    if args.clear_cache:
        files_to_remove = [DATA_FILE, VPN_IP_FILE, RESULTS_CACHE_FILE]
        for f in files_to_remove:
            if os.path.exists(f):
                os.remove(f)
                print(f"Removed {f}")
        print("All cache files have been cleared. ✨")
        exit()

    if args.update_vpn_list:
        update_vpn_ip_list(verbose=args.verbose)
        exit()

    if args.speedtest and not any([args.force_refresh, args.no_gps]):
        run_speed_test(verbose=args.verbose)
    else:
        get_ip_details(verbose=args.verbose, force_refresh=args.force_refresh, no_gps=args.no_gps)
        display_local_network_info(verbose=args.verbose)
        if args.speedtest:
             run_speed_test(verbose=args.verbose)
